---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBand from '../../components/PageBand.astro';
import Photo from '../../components/Photo.astro';
import { sortedPosts } from '../../data/content';
import { breadcrumbs } from '../../lib/seo';

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout
  title="Parenting Tips & Online Learning Advice | Likulearn Blog"
  description="Practical ideas and tips for parents supporting children aged 3–18 who learn online: study habits, subject choices and home learning set-ups."
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }])]}
>
  <PageBand eyebrow="Blog" title="Insights & Parenting Tips" lead="Ideas and practical tips for supporting your child’s learning at home." />
  <section class="section">
    <div class="grid">
      {sortedPosts.map((p) => (
        <a href={`/blog/${p.slug}`} class="post" data-reveal>
          <figure class="img"><Photo image={p.cover} class="fade-img" sizes="(max-width: 720px) 100vw, 360px" widths={[480, 800]} /></figure>
          <div class="body">
            <time datetime={p.date}>{dateFmt.format(new Date(p.date))}</time>
            <h2>{p.title}</h2>
            <p>{p.excerpt}</p>
            <span class="more">Read more <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .post {
    display: flex; flex-direction: column; background: #fff; border-radius: 16px; overflow: hidden; color: var(--ink);
    box-shadow: 0 14px 40px -18px rgba(14,59,54,.3);
    transition: transform 350ms var(--ease-out), box-shadow 350ms var(--ease-out);
  }
  .post:hover { color: var(--ink); transform: translateY(-6px); box-shadow: 0 24px 50px -20px rgba(14,59,54,.45); }
  .img { aspect-ratio: 16 / 10; background: #E8EEED; overflow: hidden; }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out), opacity 600ms ease; }
  .post:hover .img :global(img) { transform: scale(1.06); }
  .body { padding: 20px 22px 24px; display: flex; flex-direction: column; gap: 8px; }
  time { font-size: 12px; color: var(--muted); }
  h2 { font-size: 18px; font-weight: 500; margin: 0; line-height: 1.35; }
  p { font-size: 14px; color: var(--muted); line-height: 1.6; margin: 0; }
  .more { color: var(--orange); font-size: 13px; margin-top: 6px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
