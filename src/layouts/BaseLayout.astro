---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { home } from '../data/content';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative image for link previews. Defaults to the hero photo. */
  image?: string | null;
  imageAlt?: string;
  /** 'article' for blog posts. */
  type?: 'website' | 'article';
  /** ISO date, for articles. */
  publishedTime?: string;
  /** Schema.org objects for this page, emitted as JSON-LD. */
  schema?: Record<string, unknown>[];
  /** Keep the page out of search results (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description = 'Live online classes for ages 3–18 across Science, Commercial and Arts subjects. Register your children in minutes and book a free trial class.',
  image = home.hero_image.src,
  imageAlt = image === home.hero_image.src ? home.hero_image.alt : undefined,
  type = 'website',
  publishedTime,
  schema = [],
  noindex = false,
} = Astro.props;

const base = Astro.site ?? Astro.url.origin;
const ogImage = image ? new URL(image, base).href : null;

// No trailing slash (see trailingSlash in astro.config.mjs), except the root.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, base).href;

// `<` escaped so text in the data can never close the script tag.
const jsonLd = schema.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema }).replace(/</g, '\\u003c')
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Likulearn Blog" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="theme-color" content="#0E3B36" />
    <meta property="og:site_name" content="Likulearn" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Fredoka:wght@600;700&display=swap" rel="stylesheet" />

    <!-- Turn on entrance/reveal motion before first paint, unless the visitor asked for reduced motion. -->
    <script is:inline>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter title={home.footer_title} about={home.footer_about} email={home.contact_email} whatsapp={home.whatsapp_number} />

    <script>
      const root = document.documentElement;

      // Fade images in once loaded.
      document.querySelectorAll<HTMLImageElement>('img.fade-img').forEach((img) => {
        if (img.complete && img.naturalWidth) img.classList.add('loaded');
        else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
      });

      // Scroll reveal: fade/rise blocks as they enter the viewport, staggered among siblings.
      if (root.classList.contains('js-motion')) {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
        // Once the entrance finishes, drop the reveal styles so the element's own hover transitions apply.
        const reveal = (el: HTMLElement) => {
          el.classList.add('is-visible');
          const done = (ev: TransitionEvent) => {
            if (ev.target !== el || ev.propertyName !== 'transform') return;
            el.removeEventListener('transitionend', done);
            el.removeAttribute('data-reveal');
            el.classList.remove('is-visible');
            el.style.removeProperty('--reveal-i');
          };
          el.addEventListener('transitionend', done);
        };
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            reveal(e.target as HTMLElement);
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        const seen = new Map<Element | null, number>();
        els.forEach((el) => {
          const i = seen.get(el.parentElement) ?? 0;
          seen.set(el.parentElement, i + 1);
          el.style.setProperty('--reveal-i', String(Math.min(i, 7)));
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
