---
/** Shared shell for the privacy policy and terms: page band, then readable long-form text. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBand from './PageBand.astro';
import { breadcrumbs } from '../lib/seo';

interface Props { title: string; description: string; path: string; updated: string }
const { title, description, path, updated } = Astro.props;
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(updated));
---
<BaseLayout
  title={title + ' | Likulearn'}
  description={description}
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: title, path }])]}
>
  <PageBand eyebrow={'Last updated ' + date} title={title} lead={description} />
  <article class="legal" data-reveal>
    <slot />
  </article>
</BaseLayout>

<style>
  .legal { max-width: 760px; margin: 0 auto; padding: 56px 24px 96px; font-size: 16px; line-height: 1.75; color: #2A3836; }
  .legal :global(h2) { font-size: 22px; font-weight: 500; color: var(--ink); margin: 40px 0 10px; line-height: 1.3; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(p), .legal :global(ul) { margin: 0 0 1em; }
  .legal :global(ul) { padding-left: 1.25em; }
  .legal :global(li) { margin-bottom: .4em; }
  .legal :global(strong) { color: var(--ink); font-weight: 600; }
  @media (max-width: 720px) {
    .legal { padding: 40px 16px 72px; font-size: 15px; }
  }
</style>
