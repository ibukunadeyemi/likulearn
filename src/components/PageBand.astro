---
/** Green band at the top of inner pages, so the see-through header has something to sit on. */
interface Props { eyebrow?: string; title: string; lead?: string | null }
const { eyebrow, title, lead } = Astro.props;
---
<header class="band grid-bg">
  <div class="band-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>

<style>
  .band { padding-top: var(--nav-h); }
  .band-inner { max-width: 820px; margin: 0 auto; padding: 56px 24px 64px; text-align: center; }
  .band-inner > * { animation: rise-in 700ms var(--ease-out) both; }
  .band-inner > :nth-child(2) { animation-delay: 80ms; }
  .band-inner > :nth-child(3) { animation-delay: 160ms; }
  .eyebrow { margin: 0 0 12px; color: var(--orange-light); font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0; color: #fff; font-size: clamp(30px, 4.4vw, 48px); font-weight: 500; line-height: 1.15; letter-spacing: -.02em; text-wrap: balance; }
  .lead { margin: 16px auto 0; max-width: 600px; color: rgba(255,255,255,.72); font-size: 17px; line-height: 1.6; text-wrap: pretty; }
  @media (max-width: 720px) { .band-inner { padding: 40px 16px 48px; } }
</style>
