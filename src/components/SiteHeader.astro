---
import { NAV_LINKS } from '../data/site';
---
<header id="site-nav">
  <div class="nav-shell">
    <a href="/" class="brand" aria-label="Likulearn home">
      <img src="/logo-dark.svg" alt="" width="140" height="39" />
    </a>
    <nav class="nav-links" aria-label="Main">
      {NAV_LINKS.map((l) => <a href={l.href} data-spy={l.href.split('#')[1]}>{l.label}</a>)}
    </nav>
    <div class="nav-actions">
      <a href="/#enrol" class="nav-login">Log in</a>
      <a href="/#enrol" class="btn btn-orange btn-sm">Enrol your child</a>
      <button type="button" id="menu-toggle" class="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
  <!-- Small-screen menu: everything the desktop nav shows, in a dropdown panel. -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Menu" hidden>
    {NAV_LINKS.map((l) => <a href={l.href}>{l.label}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg></a>)}
    <div class="mobile-menu-actions">
      <a href="/#enrol" class="btn mm-ghost">Log in</a>
      <a href="/#enrol" class="btn btn-orange">Enrol your child</a>
    </div>
  </nav>
</header>

<script>
  const nav = document.getElementById('site-nav')!;
  const menuBtn = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  // Full-width and transparent over the hero; once scrolled it shrinks into a floating glass bar.
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Small-screen menu.
  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav.classList.toggle('menu-open', open);
  };
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { setMenu(false); menuBtn.focus(); } });
  document.addEventListener('click', (e) => { if (!menu.hidden && !nav.contains(e.target as Node)) setMenu(false); });
  window.matchMedia('(min-width: 821px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

  // Highlight the nav link for the section currently in view.
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-spy]')].filter((a) => a.dataset.spy);
  const sections = links.map((a) => document.getElementById(a.dataset.spy!)).filter((s): s is HTMLElement => !!s);
  const spy = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('active', a.dataset.spy === e.target.id));
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  sections.forEach((s) => spy.observe(s));
</script>

<style>
  header#site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 0 24px;
    /* Overlap the hero so its green runs up behind the transparent bar. */
    margin-bottom: calc(-1 * var(--nav-h));
    transition: top 350ms var(--ease-spring);
  }
  header#site-nav.scrolled { top: 12px; }
  .nav-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 12px 0 20px;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 24px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0;
    box-shadow: none;
    transition:
      max-width 350ms var(--ease-spring),
      height 350ms var(--ease-spring),
      border-radius 350ms var(--ease-spring),
      background 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease;
  }
  header#site-nav.scrolled .nav-shell {
    max-width: 1100px;
    height: 62px;
    border-radius: 16px;
    background: var(--nav-glass);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 14px 34px -12px rgba(14, 59, 54, 0.45);
  }

  .brand { display: inline-flex; flex: none; }
  .brand img { height: 39px; width: auto; transition: height 350ms var(--ease-spring), transform 300ms var(--ease-out); }
  .brand:hover img { transform: rotate(-3deg) scale(1.04); }
  header#site-nav.scrolled .brand img { height: 34px; }

  .nav-links { display: flex; gap: 4px; flex: 1; justify-content: center; }
  .nav-links a {
    position: relative;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.8);
    transition: color 200ms ease, background 200ms ease;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 14px; right: 14px; bottom: 3px;
    height: 2px;
    border-radius: 2px;
    background: var(--orange-light);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease-out);
  }
  .nav-links a:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .nav-links a.active { color: #fff; }
  .nav-links a.active::after { transform: scaleX(1); }

  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .nav-login { color: #fff; font-size: 14px; padding: 9px 12px; border-radius: 8px; transition: background 200ms ease; }
  .nav-login:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }

  /* ---------- hamburger ---------- */
  .menu-btn {
    display: none;
    width: 40px; height: 40px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    cursor: pointer;
    align-items: center; justify-content: center;
    flex: none;
  }
  .burger { position: relative; width: 18px; height: 12px; }
  .burger span {
    position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px; background: #fff;
    transition: transform 300ms var(--ease-out), opacity 200ms ease, top 300ms var(--ease-out);
  }
  .burger span:nth-child(1) { top: 0; }
  .burger span:nth-child(2) { top: 5px; }
  .burger span:nth-child(3) { top: 10px; }
  .menu-btn[aria-expanded="true"] .burger span:nth-child(1) { top: 5px; transform: rotate(45deg); }
  .menu-btn[aria-expanded="true"] .burger span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .menu-btn[aria-expanded="true"] .burger span:nth-child(3) { top: 5px; transform: rotate(-45deg); }

  .mobile-menu {
    position: absolute;
    left: 24px; right: 24px;
    top: calc(100% + 8px);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px rgba(14, 59, 54, 0.25);
    transform-origin: top center;
    animation: menu-in 260ms var(--ease-out);
    max-height: calc(100dvh - 100px);
    overflow-y: auto;
  }
  .mobile-menu[hidden] { display: none; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }
  .mobile-menu > a {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 48px; padding: 0 14px; border-radius: 10px;
    font-size: 16px; font-weight: 500; color: var(--ink);
    animation: rise-in 360ms var(--ease-out) both;
  }
  .mobile-menu > a:nth-child(2) { animation-delay: 30ms; }
  .mobile-menu > a:nth-child(3) { animation-delay: 60ms; }
  .mobile-menu > a:nth-child(4) { animation-delay: 90ms; }
  .mobile-menu > a:nth-child(5) { animation-delay: 120ms; }
  .mobile-menu > a svg { color: var(--orange); transition: transform 250ms var(--ease-out); }
  .mobile-menu > a:hover { background: var(--cream); color: var(--ink); }
  .mobile-menu > a:hover svg { transform: translateX(3px); }
  .mobile-menu-actions {
    display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
    margin-top: 8px; padding-top: 12px; border-top: 1px solid var(--line);
  }
  .mobile-menu-actions .btn { padding: 12px 16px; font-size: 14px; }
  .mm-ghost { border: 1px solid var(--line); color: var(--ink); background: #fff; }
  .mm-ghost:hover { color: var(--ink); border-color: var(--green); }

  @media (max-width: 1000px) {
    .nav-shell { gap: 12px; }
    .nav-links a { padding: 8px 10px; }
    .nav-links a::after { left: 10px; right: 10px; }
  }
  @media (max-width: 820px) {
    :global(:root) { --nav-h: 64px; }
    .nav-links { display: none; }
    .nav-shell { justify-content: space-between; }
    .menu-btn { display: inline-flex; }
    .nav-login { display: none; }
    header#site-nav.scrolled .nav-shell { height: 58px; }
  }
  @media (max-width: 560px) {
    header#site-nav { padding: 0 12px; }
    header#site-nav.scrolled { top: 8px; }
    .nav-shell { padding: 0 8px 0 14px; }
    .nav-actions { gap: 6px; }
    .nav-actions .btn-sm { padding: 9px 12px; font-size: 13px; }
    .brand img, header#site-nav.scrolled .brand img { height: 30px; }
    .mobile-menu { left: 12px; right: 12px; }
  }
  /* Narrowest phones: the Enrol button moves into the menu. */
  @media (max-width: 359px) {
    .nav-actions > .btn-sm { display: none; }
  }
</style>
