---
/** A titled grid of short cards. Numbered for processes, plain for lists of reasons. */
import Rich from './Rich.astro';

interface Props {
  title: string;
  intro?: string | null;
  items: { title: string; text: string }[];
  numbered?: boolean;
  tone?: 'white' | 'cream';
}
const { title, intro, items, numbered = false, tone = 'white' } = Astro.props;
const List = numbered ? 'ol' : 'ul';
---
<div class:list={['info-wrap', tone]}>
  <section class="section">
    <h2 class="section-title tight" data-reveal><Rich text={title} /></h2>
    {intro ? <p class="section-lead" data-reveal>{intro}</p> : <div class="spacer" />}
    <List class="info-grid">
      {items.map((item, i) => (
        <li class="info-card" data-reveal>
          {numbered && <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </List>
  </section>
</div>

<style>
  .info-wrap.cream { background: var(--cream); }
  .spacer { height: 34px; }
  .info-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .info-card {
    padding: 26px 24px; border-radius: 16px; background: #fff; border: 1.5px solid var(--line-warm);
    transition: transform 300ms var(--ease-out), border-color 250ms ease, box-shadow 300ms var(--ease-out);
  }
  .cream .info-card { border-color: transparent; }
  .info-card:hover { transform: translateY(-4px); border-color: var(--green); box-shadow: 0 18px 40px -26px rgba(14,59,54,.55); }
  .num { display: block; margin-bottom: 12px; font-family: 'Fredoka', sans-serif; font-size: 26px; font-weight: 700; line-height: 1; color: var(--orange); }
  h3 { margin: 0 0 8px; font-size: 17px; font-weight: 600; line-height: 1.35; color: var(--ink); }
  p { margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--muted); }
  @media (max-width: 720px) { .info-grid { grid-template-columns: 1fr; } }
</style>
